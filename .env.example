# Copy to .env (next to docker-compose.yml) and fill in.  nano .env

# The web address, without https://. Its DNS A record must point to this server.
# It is printed inside every QR code, so decide it before printing posters.
DOMAIN=attendance.yourcompany.com

# Optional: more addresses for the public website (prices, free-trial sign-up), separated by spaces.
# Add them only after their DNS A records point to this server, e.g.  WEBSITE_DOMAINS=mysoftkh.com www.mysoftkh.com
WEBSITE_DOMAINS=

# Optional public demo ("DemoCompany", 6 months of sample data, rebuilt every night), e.g.
#   DEMO_DOMAIN=demo.attendance.mysoftkh.com                    (the demo dashboard and staff app)
#   DEMO_WEBSITE_DOMAINS=demo.mysoftkh.com www.demo.mysoftkh.com  (the website on the demo)
#   COMPOSE_PROFILES=demo                                        (starts the demo container)
# Demo addresses must start with "demo." or "www.demo.". setup.sh fills in DEMO_JWT_SECRET.
DEMO_DOMAIN=
DEMO_WEBSITE_DOMAINS=

# Long random strings. Make each one with:  openssl rand -hex 32
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters

# First platform super admin. Created on the very first start only; you must change the password at first sign-in.
SUPERADMIN_EMAIL=you@yourcompany.com
SUPERADMIN_PASSWORD=ChangeMe123

# Days of nightly database backups to keep in ./backups
BACKUP_DAYS=14
# Hour (UTC) of the nightly backup. 18 = 01:00 in Cambodia (UTC+7).
BACKUP_HOUR_UTC=18
